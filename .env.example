# Copy to .env.production for Docker Compose, or to apps/api/.env and
# the service directories for local `go run`. Never commit real values.

# --- Application database connection (all services) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=pipeline
DB_USER=pipeline
DB_PASSWORD=change-me
DB_SSLMODE=disable

# Connection pool, per service process. Durations use Go syntax (30s, 5m).
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# --- Logging and metrics (all services) ---
# LOG_FORMAT: text (readable) or json (for log aggregators; compose sets json).
LOG_FORMAT=text
# LOG_LEVEL: debug, info, warn or error.
LOG_LEVEL=info
# Internal port for /health and /metrics on the API and workers. Give each
# process its own port when running several locally with `go run`.
METRICS_PORT=9090

# --- PostgreSQL container initialization (docker compose only) ---
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pipeline

# --- API (apps/api) ---
API_PORT=8080
UPLOADS_DIR=./uploads

# Comma-separated API keys. Clients send "Authorization: Bearer <key>" or
# "X-API-Key: <key>". When empty, authentication is DISABLED (dev only).
API_KEYS=change-me-dev-key

# Per-client token bucket: average requests per minute and burst size.
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is
# trusted for the client address. Leave empty when not behind a proxy.
TRUSTED_PROXIES=

# Stalled-job recovery, run by the API process.
# A job whose heartbeat is older than JOB_STALE_AFTER is moved back to the
# previous stage; after JOB_MAX_RETRIES recoveries it is marked failed.
JOB_STALE_AFTER=60s
JOB_MAX_RETRIES=3
JOB_REAPER_INTERVAL=15s

# --- Validation service ---
VALIDATION_PORT=8081
VALIDATION_WORKERS=4

# --- Stage workers (ingestion, transformation, aggregation, export) ---
# Workers wake on PostgreSQL LISTEN/NOTIFY; this is the fallback check
# interval in case a notification is missed.
WORKER_POLL_INTERVAL=30s

# --- Ingestion worker ---
VALIDATION_SERVICE_URL=http://localhost:8081

# --- Transformation worker ---
TRANSFORMATION_WORKERS=5
TRANSFORMED_OUTPUT_DIR=./output

# --- Aggregation and export workers ---
AGGREGATED_OUTPUT_DIR=./output
EXPORTED_OUTPUT_DIR=./output

# --- End-to-end test (scripts/e2e-test.sh) ---
# Must be one of API_KEYS when authentication is enabled.
API_KEY=change-me-dev-key

# --- Tests ---
# Use a separate database; integration tests skip when this is empty.
TEST_DATABASE_URL=postgres://pipeline:change-me@localhost:5433/pipeline_test?sslmode=disable
