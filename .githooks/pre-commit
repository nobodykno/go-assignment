
#!/bin/sh
set -eu

echo "Checking Go formatting..."

unformatted=$(find apps packages services \
  -type f -name '*.go' \
  -exec gofmt -l {} +)

if [ -n "$unformatted" ]; then
    echo "These files need formatting:"
    echo "$unformatted"
    echo "Run gofmt -w on the listed files."
    exit 1
fi

echo "Go formatting check passed."
